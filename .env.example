# UI-TARS Desktop Application Environment Configuration

# VLM (Vision Language Model) Configuration
VLM_PROVIDER=openai
VLM_BASE_URL=https://api.openai.com/v1
VLM_API_KEY=
VLM_MODEL_NAME=gpt-4o

# OrPaynter Platform Integration
ORPAYNTER_API_BASE=https://api.orpaynter.com
ORPAYNTER_TOKEN=
ORPAYNTER_ENVIRONMENT=development
ORPAYNTER_ENABLE_AI=true
ORPAYNTER_ENABLE_CLAIMS=true

# Third-party Services (Optional for Demo Mode)
OPENAI_API_KEY=
STRIPE_KEY=
SENDGRID_KEY=
TWILIO_KEY=
QDRANT_URL=
QDRANT_KEY=
OPENWEATHER_KEY=

# Application Settings
NODE_ENV=development
PORT=1212
START_MINIMIZED=false
UPGRADE_EXTENSIONS=false

# Development & Testing
CI=
ELECTRON_RENDERER_URL=

# Private Key for App Security (Base64 encoded)
UI_TARS_APP_PRIVATE_KEY_BASE64=
