# OrPaynter Platform Integration
ORPAYNTER_API_BASE=https://api.orpaynter.com
ORPAYNTER_TOKEN=orpaynter_live_token_replace_with_your_actual_token
ORPAYNTER_ENVIRONMENT=development
ORPAYNTER_ENABLE_AI=true
ORPAYNTER_ENABLE_CLAIMS=true

# External Services (OrPaynter Integration)
# Replace these example keys with your actual API keys
OPENAI_API_KEY=sk-proj-example_openai_key_replace_with_real_key
STRIPE_KEY=pk_live_example_stripe_key_replace_with_real_publishable_key
SENDGRID_KEY=SG.example_sendgrid_api_key.replace_with_your_actual_key
TWILIO_KEY=example_twilio_account_sid_replace_with_real_sid
QDRANT_URL=https://your-qdrant-instance.cloud:6333
QDRANT_KEY=example_qdrant_api_key_replace_with_your_actual_key
OPENWEATHER_KEY=example_openweather_api_key_replace_with_real_key
