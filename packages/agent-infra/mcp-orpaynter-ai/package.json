{
  "name": "@agent-infra/mcp-orpaynter-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-orpaynter-ai": "dist/index.cjs"
  },
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "shx rm -rf dist && rslib build && shx chmod +x dist/*.{js,cjs}",
    "prepare": "npm run build",
    "watch": "npm run build && rslib build --watch",
    "dev": "npx -y @modelcontextprotocol/inspector tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-infra/mcp-shared": "workspace:*",
    "@modelcontextprotocol/sdk": "~1.15.1",
    "zod": "^3.23.8",
    "ofetch": "^1.3.4"
  },
  "devDependencies": {
    "@rslib/core": "0.5.3",
    "shx": "^0.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "@types/node": "^22",
    "vitest": "^3.0.7"
  }
}