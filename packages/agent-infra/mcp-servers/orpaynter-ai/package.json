{
  "name": "@agent-infra/mcp-server-orpaynter-ai",
  "version": "1.0.0",
  "description": "MCP server for OrPaynter AI analysis tools",
  "type": "module",
  "main": "./dist/server.cjs",
  "module": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "bin": {
    "mcp-server-orpaynter-ai": "./dist/index.cjs"
  },
  "homepage": "https://github.com/orpaynter/UI-TARS-desktop",
  "bugs": "https://github.com/orpaynter/UI-TARS-desktop/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/orpaynter/UI-TARS-desktop.git",
    "directory": "packages/agent-infra/mcp-servers/orpaynter-ai"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "shx rm -rf dist && rslib build && shx chmod +x dist/*.{js,cjs}",
    "prepare": "npm run build",
    "watch": "rslib build --watch",
    "dev": "npx -y @modelcontextprotocol/inspector tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.15.1",
    "zod": "^3.23.8",
    "ofetch": "^1.3.4"
  },
  "devDependencies": {
    "@rslib/core": "0.5.3",
    "shx": "^0.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "@types/node": "^22"
  }
}
