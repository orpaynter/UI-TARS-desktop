{
  "name": "@orpaynter/connector-supabase",
  "version": "1.0.0",
  "description": "Supabase connector for OrPaynter - Database and authentication operations",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "supabase",
    "database",
    "authentication",
    "realtime",
    "orpaynter",
    "connector"
  ],
  "author": "OrPaynter",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0"
  }
}
