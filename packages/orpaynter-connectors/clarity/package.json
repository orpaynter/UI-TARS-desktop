{
  "name": "@orpaynter/connector-clarity",
  "version": "1.0.0",
  "description": "Microsoft Clarity connector for OrPaynter - Session replay and user behavior analytics",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "clarity",
    "microsoft-clarity",
    "analytics",
    "session-replay",
    "heatmaps",
    "orpaynter",
    "connector"
  ],
  "author": "OrPaynter",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
