{
  "name": "@orpaynter/toolkit-ai-estimator",
  "version": "1.0.0",
  "description": "AI-powered smart estimation toolkit for roofing projects with computer vision and predictive analytics",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "ai",
    "estimation",
    "computer-vision",
    "roofing",
    "orpaynter",
    "toolkit"
  ],
  "author": "OrPaynter",
  "license": "MIT",
  "dependencies": {
    "ofetch": "^1.3.4"
  },
  "devDependencies": {
    "@rslib/core": "0.5.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "@types/node": "^22"
  }
}
